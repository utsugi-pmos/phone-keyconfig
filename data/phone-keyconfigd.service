[Unit]
Description=phone-keyconfig: the power and volume buttons
# A user service: the buttons belong to whoever is at the screen, and every
# action it runs (the power menu, brightness, an app) lives on the session bus.
# It grabs the input devices with an ACL the udev rule grants to the seat's
# active user, so it only makes sense once the session is up.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/phone-keyconfigd
# If it dies, the grab dies with it and the buttons fall back to the shell's
# native handling: nothing is ever stuck. Come back quickly all the same.
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
